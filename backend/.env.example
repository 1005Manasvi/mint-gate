# Copy to backend/.env (git-ignored) for local runs. On Hugging Face these are
# set as Space *secrets* instead. NEVER commit the real file.

# "production" refuses to start with insecure defaults
APP_ENV=development

# Blockchain
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EXPLORER_URL=https://sepolia.etherscan.io
VERIFIER_PRIVATE_KEY=

# Human reviewer secret (>= 16 random characters)
REVIEWER_KEY=

# IPFS pinning (pinata.cloud -> API Keys -> JWT)
PINATA_JWT=

# Public URL of the app (used in NFT metadata links)
PUBLIC_BASE_URL=http://127.0.0.1:5000
