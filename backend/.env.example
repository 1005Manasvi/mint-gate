# Copy to backend/.env (git-ignored) for local runs. On Hugging Face these are
# set as Space *secrets* instead. NEVER commit the real file.

# "production" refuses to start with insecure defaults
APP_ENV=development

# Data services (docker compose up -d; then: python -m alembic upgrade head)
DATABASE_URL=postgresql+psycopg://mintgate:mintgate@127.0.0.1:5432/mintgate
REDIS_URL=redis://127.0.0.1:6379/0

# Blockchain (contracts v2, backend/chain/deployments/<network>.json)
# Networks the indexer follows; the first is the default for backend-submitted verdicts.
CHAIN_NETWORKS=baseSepolia,sepolia
DEFAULT_NETWORK=baseSepolia
# Optional per-network overrides: RPC_URL_<NETWORK>, CONFIRMATIONS_<NETWORK>, PRIORITY_FEE_GWEI_<NETWORK>
RPC_URL_BASESEPOLIA=https://sepolia.base.org
RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
# Verifier key: signs EIP-712 verdicts and pays for REVIEW / FAIL anchoring + resolveReview.
VERIFIER_PRIVATE_KEY=
# 0 = do not put FAIL verdicts on chain (saves gas; REVIEW verdicts are always anchored)
ANCHOR_FAILED_VERDICTS=1

# Human reviewer secret (>= 16 random characters)
REVIEWER_KEY=

# IPFS pinning (pinata.cloud -> API Keys -> JWT)
PINATA_JWT=

# Public URL of the app (used in NFT metadata links)
PUBLIC_BASE_URL=http://127.0.0.1:5000
