# any secret file, anywhere
**/.env
.env.*
!**/.env.example
# local-only artefacts
backend/chain/deployment.local.json
backend/chain/deployments/localhost.json
backend/storage/
.vscode/
*.pyc
# test / lint caches
.pytest_cache/
.ruff_cache/
# copy-engine weights: fetched by `python -m benchmark.fetch_models` / built by `benchmark.export_onnx`
backend/model/copydet/*.pt
backend/model/copydet/*.part
backend/model/copydet/*.onnx
# vision towers of the AI-detector backbones: `python -m training.ai_backbones fetch` (SHA-256 in manifest.json)
backend/model/backbones/*/model.safetensors
# TruFor weights (non-commercial): `python -m benchmark.forgery fetch` (SHA-256 in manifest.json)
backend/model/trufor/*.safetensors
backend/model/trufor/*.pth.tar
backend/model/backbones/*/vision.onnx
backend/model/system_eval_progress.json
