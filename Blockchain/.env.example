# Copy to Blockchain/.env (git-ignored) and fill in. NEVER commit the real file.

# Private key of the wallet that deploys the contract and acts as verifier
# (MetaMask -> account details -> show private key). Must hold Sepolia test ETH.
DEPLOYER_PRIVATE_KEY=

# Optional: your own RPC (Alchemy / Infura). Defaults to a free public Sepolia RPC.
SEPOLIA_RPC_URL=
# Optional: Base Sepolia RPC (defaults to https://sepolia.base.org).
BASE_SEPOLIA_RPC_URL=

# Optional: lets `npx hardhat verify` publish the source code on Etherscan.
ETHERSCAN_API_KEY=
