{
  "name": "mint-gate-chain",
  "version": "2.0.0",
  "private": true,
  "description": "MintGateNFT: on-chain provenance for AI-verified artwork",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "coverage": "hardhat coverage && node scripts/check-coverage.js",
    "format": "prettier --write --config ../.prettierrc.json --ignore-path ../.prettierignore contracts scripts test hardhat.config.js .solcover.js ../frontend/js ../frontend/tests ../e2e/tests ../e2e/playwright.config.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "dotenv": "^16.4.5",
    "forge-std": "github:foundry-rs/forge-std#v1.17.0",
    "hardhat": "^2.22.17",
    "prettier": "^3.9.10",
    "prettier-plugin-solidity": "^1.4.3"
  }
}
